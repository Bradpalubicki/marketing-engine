# ============================================================
# marketing-engine — .env.local.example
# All values sourced from Doppler: marketing-engine / prd
# Run locally: doppler run --project marketing-engine --config prd -- next dev
# DO NOT commit real values. This file is for reference only.
# ============================================================

# Auth — Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=        # [Doppler: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY]
CLERK_SECRET_KEY=                         # [Doppler: CLERK_SECRET_KEY]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=            # [Doppler: NEXT_PUBLIC_CLERK_SIGN_IN_URL]
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=      # [Doppler: NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL]

# Database — Supabase
NEXT_PUBLIC_SUPABASE_URL=                 # [Doppler: NEXT_PUBLIC_SUPABASE_URL]
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # [Doppler: NEXT_PUBLIC_SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=                # [Doppler: SUPABASE_SERVICE_ROLE_KEY]

# AI — Anthropic
ANTHROPIC_API_KEY=                        # [Doppler: ANTHROPIC_API_KEY]

# Background Jobs — Inngest
INNGEST_EVENT_KEY=                        # [Doppler: INNGEST_EVENT_KEY]
INNGEST_SIGNING_KEY=                      # [Doppler: INNGEST_SIGNING_KEY]

# Email — Resend
RESEND_API_KEY=                           # [Doppler: RESEND_API_KEY]

# SMS — Twilio
TWILIO_ACCOUNT_SID=                       # [Doppler: TWILIO_ACCOUNT_SID]
TWILIO_AUTH_TOKEN=                        # [Doppler: TWILIO_AUTH_TOKEN]
TWILIO_FROM_NUMBER=                       # [Doppler: TWILIO_FROM_NUMBER]

# Payments — Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=       # [Doppler: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY]
STRIPE_SECRET_KEY=                        # [Doppler: STRIPE_SECRET_KEY]
STRIPE_WEBHOOK_SECRET=                    # [Doppler: STRIPE_WEBHOOK_SECRET]

# Google APIs (GBP + Ads)
GOOGLE_CLIENT_ID=                         # [Doppler: GOOGLE_CLIENT_ID] — Brad must provide (OAuth)
GOOGLE_CLIENT_SECRET=                     # [Doppler: GOOGLE_CLIENT_SECRET] — Brad must provide (OAuth)
GOOGLE_PAGESPEED_API_KEY=                 # [Doppler: GOOGLE_PAGESPEED_API_KEY]
GOOGLE_PLACES_API_KEY=                    # [Doppler: GOOGLE_PLACES_API_KEY]

# Agency — NuStack internal
AGENCY_ENGINE_URL=                        # [Doppler: AGENCY_ENGINE_URL]
AGENCY_SECRET=                            # [Doppler: AGENCY_SECRET]

# Monitoring — Sentry
NEXT_PUBLIC_SENTRY_DSN=                   # [Doppler: NEXT_PUBLIC_SENTRY_DSN]
SENTRY_DSN=                               # [Doppler: SENTRY_DSN]
SENTRY_AUTH_TOKEN=                        # [Doppler: SENTRY_AUTH_TOKEN]
SENTRY_ORG=                               # [Doppler: SENTRY_ORG]
SENTRY_PROJECT=                           # [Doppler: SENTRY_PROJECT]

# Monitoring — PostHog
NEXT_PUBLIC_POSTHOG_KEY=                  # Not in Doppler yet — add when configured
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com  # [Doppler: NEXT_PUBLIC_POSTHOG_HOST]

# Alerting
SLACK_ALERT_WEBHOOK_URL=                  # [Doppler: SLACK_ALERT_WEBHOOK_URL]

# Webhooks
CRON_SECRET=                              # [Doppler: CRON_SECRET]
APPOINTMENTS_WEBHOOK_SECRET=              # [Doppler: APPOINTMENTS_WEBHOOK_SECRET] — Brad must provide

# Integration
NOTION_INTEGRATION_TOKEN=                 # [Doppler: NOTION_INTEGRATION_TOKEN]
JWT_SECRET=                               # [Doppler: JWT_SECRET]

# App
NEXT_PUBLIC_APP_URL=                      # [Doppler: NEXT_PUBLIC_APP_URL]
BRAD_EMAIL=                               # [Doppler: BRAD_EMAIL]
BRAD_PHONE=                               # [Doppler: BRAD_PHONE]

# GBP Phase 2 blockers (Brad must provide — OAuth required)
GBP_CLIENT_ID=                            # Not yet in Doppler — Brad provides after GCP OAuth setup
GBP_CLIENT_SECRET=                        # Not yet in Doppler — Brad provides after GCP OAuth setup
GBP_REFRESH_TOKEN=                        # Not yet in Doppler — Brad provides after GCP OAuth setup

# Feature flags
FEATURE_GOOGLE_ADS=false                  # Flip to true once Standard developer token approved
FEATURE_META_ADS=false                    # Flip to true once Meta App Review approved
FEATURE_TIKTOK_ADS=false
FEATURE_LINKEDIN_ADS=false
FEATURE_STACKADAPT=false
FEATURE_TTD=false
FEATURE_MICROSOFT_ADS=false
